static func t(s: String) -> String:
	if Settings.lang != "en":
		return s
	if EN.has(s):
		return EN[s]
	if s.begins_with("Титан «") and s.ends_with("»"):  # a Titan's rolled name
		return "Titan “%s”" % EN.get(s.trim_prefix("Титан «").trim_suffix("»"), s)
	return s
